# Sathi — Environment Variables
# Copy this file to .env before running:  cp .env.example .env

# SQLite database (Prisma resolves this path relative to prisma/schema.prisma)
# This creates <project-root>/db/custom.db. First launch opens onboarding —
# you choose a fresh personal ledger or the synthetic demo history.
DATABASE_URL=file:../db/custom.db

# Serverless note (Vercel & co.): you do NOT need to set anything there.
# web/src/lib/db.ts auto-detects the serverless environment and redirects
# this file: URL to an auto-created writable copy under /tmp. The data is
# then per-instance and resets on cold starts (demo-grade).

# Durable hosted SQLite (recommended for real deployments — Turso / libSQL):
# set these two on Vercel and db.ts switches Prisma onto the libSQL driver
# adapter, so every serverless instance shares ONE persistent database.
# DATABASE_URL=libsql://your-db-your-org.turso.io
# DATABASE_AUTH_TOKEN=your-database-token

# See README "Deploying (Vercel / self-hosted)" for the 3-step setup.

# Optional: override the directory holding the trained Sathi quantile boosters.
# Defaults to ./ml-artifacts/forecast (shipped with the repo).
# SATHI_ML_ARTIFACTS=/absolute/or/relative/path/to/forecast-artifacts

# LLM safety knobs (server-side, optional):
# SATHI_LLM_ENABLED=false    — kill switch: both chat surfaces fall back to
#                              deterministic templates (default: enabled)
# SATHI_LLM_DAILY_CAP=1000   — per-instance daily LLM call budget
# SATHI_JWT_SECRET=<random>  — signs demo-login tokens; unset = random per
#                              instance (tokens re-issue after cold starts)

# Optional in-app OpenRouter (per-user, never set here): each user can paste
# their own key in Settings → Online AI chat; it is stored device-locally and
# sent only to openrouter.ai. See README §3 + invariant 7.
