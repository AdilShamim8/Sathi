# Backend environment variables — placeholders only, never real secrets.
# Copy to .env for local development. .env is git-ignored.

# Runtime environment: local | ci | production
APP_ENV=local

# SQLite database file path
DATABASE_URL=sqlite:///./data/sathi.db

# Secret used to sign short-lived demo JWTs. Any random string locally.
AUTH_SECRET=change-me-local-only

# Comma-separated allowed CORS origins: web URL, dev origin, Capacitor origin
ALLOWED_ORIGINS=http://localhost:3000,https://localhost

# LLM provider settings. The app works end to end with LLM_ENABLED=false.
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_MODEL=
LLM_ENABLED=false
LLM_DAILY_CAP=200

# Git commit hash, injected by CI for /healthz
GIT_COMMIT=local

# Frontend build-time (public by definition, baked into web/ and the APK):
# NEXT_PUBLIC_API_URL is set as a repo variable in CI, e.g. https://your-backend.example.com

# Web app (Vercel) server-side knobs — all optional, safe defaults:
# SATHI_JWT_SECRET   — signs demo-login tokens; when unset a random per-instance
#                      secret is generated (tokens re-issue after cold starts).
# SATHI_LLM_ENABLED  — kill switch; "false" disables every LLM call and both chat
#                      surfaces fall back to the deterministic templates.
# SATHI_LLM_DAILY_CAP — per-instance daily LLM call budget (default 1000).
# Users can additionally enable their OWN OpenRouter key in Settings
# (device-local, sent only to openrouter.ai; see README §3).
