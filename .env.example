# Sathi — Environment Variables
# Copy this file to .env before running:  cp .env.example .env

# SQLite database (Prisma resolves this path relative to prisma/schema.prisma)
# This creates <project-root>/db/custom.db. First launch opens onboarding —
# you choose a fresh personal ledger or the synthetic demo history.
DATABASE_URL=file:../db/custom.db

# Optional: override the directory holding the trained Sathi quantile boosters.
# Defaults to ./ml-artifacts/forecast (shipped with the repo).
# SATHI_ML_ARTIFACTS=/absolute/or/relative/path/to/forecast-artifacts
